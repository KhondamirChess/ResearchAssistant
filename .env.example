# Copy to .env and fill in. Never commit .env to git.
# Leave both empty to use Demo mode only.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional
LLM_MODEL=claude-haiku-4-5-20251001
# If you set your model's prices (USD per million tokens), cost is shown per run
PRICE_PER_MTOK_INPUT=0
PRICE_PER_MTOK_OUTPUT=0

# Уровень логов: DEBUG, INFO, WARNING, ERROR (логи пишутся в logs/app.log)
LOG_LEVEL=INFO
